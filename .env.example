# Copy to .env.local for development, and set the same keys in Vercel.
# Never commit .env.local.

# ---------------------------------------------------------------------------
# Booking form delivery. Configure at least one channel; every configured
# channel receives each request. With none set, the form falls back to
# pre-filled Zalo, WhatsApp and mail links and /api/lead reports delivered:false.
# ---------------------------------------------------------------------------

# Email via Resend (resend.com). The sending domain must be verified in Resend.
RESEND_API_KEY=
LEAD_FROM_ADDRESS="HTH Limousine <booking@hth.com.vn>"
# Optional. Defaults to sales4@hth.com.vn.
LEAD_TO_ADDRESS=

# Telegram message to the dispatch group. Create a bot with @BotFather, add it
# to the group, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Any URL that accepts a JSON POST: the Google Sheets script in
# scripts/google-sheets-lead-log.gs, Zapier, Make, n8n…
LEAD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------

# Basemap. Defaults to keyless OpenStreetMap raster tiles.
# Set both together when moving to a keyed provider.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Optional photographic imagery for the 3D destination map. Without it, the
# map uses keyless sources: NASA Blue Marble imagery when zoomed out, then an
# OpenStreetMap vector map with 3D buildings, both over real 3D terrain.
# With it, a "Satellite" button appears and imagery reaches street level.
# Any XYZ raster template works, for example (each needs its own key):
#   ArcGIS Location Platform:
#     https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}?token=YOUR_KEY
#   MapTiler Cloud:
#     https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_KEY
# The key is visible in the browser, so restrict it to your domains.
NEXT_PUBLIC_SATELLITE_TILES=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_SATELLITE_MAXZOOM=

# Address lookup for the quote widget. Defaults to the public Photon instance
# (photon.komoot.io). Point at a self-hosted Photon for heavy traffic.
GEOCODER_URL=

# ---------------------------------------------------------------------------
# Analytics and indexing
# ---------------------------------------------------------------------------

# GA4. Nothing loads and no events are sent unless this is set.
NEXT_PUBLIC_GA_ID=

# Indexing. Off everywhere by default, because every canonical on the site
# points at https://hth.com.vn while the deployment lives on *.vercel.app.
# Set to true in the Vercel Production environment ONLY after hth.com.vn
# resolves to Vercel. Until then robots.txt disallows everything and every
# page carries noindex.
NEXT_PUBLIC_ALLOW_INDEXING=

# Mapbox GL JS public token (pk.). Restrict it to your domains in the Mapbox account.
# Without it the destination map falls back to the MapLibre/OpenFreeMap version.
NEXT_PUBLIC_MAPBOX_TOKEN=
